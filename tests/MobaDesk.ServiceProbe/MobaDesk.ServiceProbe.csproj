    <Compile Include="..\..\src\MobaDesk\Models\MobaDeskJsonContext.cs" Link="Shared\MobaDeskJsonContext.cs" />
    <Compile Include="..\..\src\MobaDesk\Models\UpdateManifest.cs" Link="Shared\UpdateManifest.cs" />
