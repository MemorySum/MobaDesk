    <Compile Include="..\..\src\MobaDesk\Services\AppPaths.cs" Link="Shared\AppPaths.cs" />
    <Compile Include="..\..\src\MobaDesk\Services\CredentialProtector.cs" Link="Shared\CredentialProtector.cs" />
