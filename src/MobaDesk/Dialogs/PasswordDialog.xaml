<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MobaDesk.Dialogs.PasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:MobaDesk.Ui">

    <StackPanel Spacing="12" Width="380">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <PasswordBox x:Name="PasswordInput" loc:Loc.Header="Common.Password"
                     loc:Loc.Placeholder="Common.Password" />
        <CheckBox x:Name="RememberCheck" loc:Loc.Key="Password.Remember" IsChecked="True" />
    </StackPanel>
</ContentDialog>


