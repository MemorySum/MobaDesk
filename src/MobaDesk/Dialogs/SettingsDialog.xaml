<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MobaDesk.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:MobaDesk.Ui"
    CornerRadius="8">

    <ContentDialog.Title>
        <StackPanel x:Name="DragHeader" Orientation="Horizontal" Spacing="10" MinHeight="44"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent"
                    AutomationProperties.AutomationId="SettingsDragHeader"
                    loc:Loc.ToolTip="Settings.DragHint">
            <FontIcon Glyph="&#xE76F;" FontSize="13" Opacity="0.55" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>
    </ContentDialog.Title>

    <ContentDialog.Resources>
        <!-- ContentDialog's own template caps itself with these theme resources. -->
        <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">820</x:Double>
    </ContentDialog.Resources>

    <Grid Width="820" Height="500" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Category navigation -->
        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="6">
            <ListView x:Name="CategoryList" SelectionMode="Single" SelectedIndex="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="40" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListViewItem Tag="Appearance">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE790;" FontSize="15" />
                        <TextBlock loc:Loc.Key="Settings.Category.Appearance" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>

                <ListViewItem Tag="Terminal">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE756;" FontSize="15" />
                        <TextBlock loc:Loc.Key="Settings.Category.Terminal" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>

                <ListViewItem Tag="Connections">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE774;" FontSize="15" />
                        <TextBlock loc:Loc.Key="Settings.Category.Connections" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>

                <ListViewItem Tag="General">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE713;" FontSize="15" />
                        <TextBlock loc:Loc.Key="Settings.Category.General" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>

                <ListViewItem Tag="About">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE946;" FontSize="15" />
                        <TextBlock loc:Loc.Key="Settings.Category.About" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
            </ListView>
        </Border>

        <!-- Category pages -->
        <Grid Grid.Column="1">
            <ScrollViewer x:Name="AppearancePanel" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Padding="2,2,12,8">
                    <StackPanel Spacing="3">
                        <TextBlock loc:Loc.Key="Settings.Category.Appearance" FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock loc:Loc.Key="Settings.Category.AppearanceHint" FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ComboBox x:Name="ThemeCombo" loc:Loc.Header="Settings.ThemeHeader"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem loc:Loc.Key="Theme.System" Tag="System" />
                        <ComboBoxItem loc:Loc.Key="Theme.Dark" Tag="Dark" />
                        <ComboBoxItem loc:Loc.Key="Theme.Light" Tag="Light" />
                    </ComboBox>

                    <ComboBox x:Name="MaterialCombo" loc:Loc.Header="Settings.MaterialHeader"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem loc:Loc.Key="Material.Mica" Tag="Mica" />
                        <ComboBoxItem loc:Loc.Key="Material.MicaAlt" Tag="MicaAlt" />
                        <ComboBoxItem loc:Loc.Key="Material.Acrylic" Tag="Acrylic" />
                        <ComboBoxItem loc:Loc.Key="Material.Solid" Tag="Solid" />
                    </ComboBox>

                    <InfoBar x:Name="MaterialInfoBar" Severity="Warning" IsOpen="False"
                             IsClosable="True" />

                    <ComboBox x:Name="InterfaceModeCombo" loc:Loc.Header="Settings.InterfaceModeHeader"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem loc:Loc.Key="InterfaceMode.Elegant" Tag="Elegant" />
                        <ComboBoxItem loc:Loc.Key="InterfaceMode.Simple" Tag="Simple" />
                    </ComboBox>

                    <TextBlock loc:Loc.Key="Settings.InterfaceModeHint" FontSize="11"
                               TextWrapping="Wrap" Margin="0,-6,0,0"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="TerminalPanel" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Padding="2,2,12,8">
                    <StackPanel Spacing="3">
                        <TextBlock loc:Loc.Key="Settings.Category.Terminal" FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock loc:Loc.Key="Settings.Category.TerminalHint" FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="FontSizeBox" loc:Loc.Header="Settings.FontSize" Minimum="9"
                                   Maximum="32" SpinButtonPlacementMode="Hidden" />
                        <NumberBox x:Name="ScrollbackBox" Grid.Column="1" loc:Loc.Header="Settings.Scrollback"
                                   Minimum="1000" Maximum="100000" SmallChange="1000"
                                   SpinButtonPlacementMode="Hidden" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ConnectionsPanel" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Padding="2,2,12,8">
                    <StackPanel Spacing="3">
                        <TextBlock loc:Loc.Key="Settings.Category.Connections" FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock loc:Loc.Key="Settings.Category.ConnectionsHint" FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="MonitorIntervalBox" loc:Loc.Header="Settings.Interval"
                                   Minimum="1" Maximum="60" SpinButtonPlacementMode="Hidden" />
                        <NumberBox x:Name="ConnectionTimeoutBox" Grid.Column="1"
                                   loc:Loc.Header="Settings.Timeout" Minimum="5" Maximum="120"
                                   SpinButtonPlacementMode="Hidden" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="GeneralPanel" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Padding="2,2,12,8">
                    <StackPanel Spacing="3">
                        <TextBlock loc:Loc.Key="Settings.Category.General" FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock loc:Loc.Key="Settings.Category.GeneralHint" FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ComboBox x:Name="LanguageCombo" loc:Loc.Header="Settings.LanguageHeader"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem loc:Loc.Key="Language.Chinese" Tag="zh-CN" />
                        <ComboBoxItem loc:Loc.Key="Language.English" Tag="en-US" />
                    </ComboBox>

                    <CheckBox x:Name="CopyOnSelectCheck" loc:Loc.Key="Settings.CopyOnSelect" />

                    <TextBlock loc:Loc.Key="Settings.ApplyInstantHint" FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AboutPanel" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Padding="2,2,12,8">
                    <StackPanel Spacing="3">
                        <TextBlock loc:Loc.Key="Settings.Category.About" FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock loc:Loc.Key="Settings.Category.AboutHint" FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border Width="56" Height="56" CornerRadius="16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#38BDF8" Offset="0" />
                                    <GradientStop Color="#2563EB" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="M" Foreground="White" FontWeight="Bold" FontSize="24"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="MobaDesk" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="AboutVersionText" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock loc:Loc.Key="About.Tagline" TextWrapping="Wrap" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE946;" FontSize="13"
                                          Foreground="{StaticResource BrandBlueBrush}" />
                                <TextBlock loc:Loc.Key="Empty.Why" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                            <TextBlock loc:Loc.Key="About.Features" TextWrapping="Wrap" FontSize="12"
                                       LineHeight="20"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE895;" FontSize="13"
                                          Foreground="{StaticResource BrandBlueBrush}" />
                                <TextBlock loc:Loc.Key="Update.Section" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>

                            <TextBlock loc:Loc.Key="Update.SourceHint" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                            <CheckBox x:Name="AutoUpdateCheck" loc:Loc.Key="Update.AutoCheck" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="CheckUpdateButton" Click="OnCheckUpdateClick"
                                        loc:Loc.Key="Update.Check" />
                                <Button x:Name="InstallUpdateButton" Click="OnInstallUpdateClick"
                                        Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}"
                                        loc:Loc.Key="Update.DownloadAndInstall" />
                            </StackPanel>

                            <TextBlock x:Name="UpdateStatusText" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ContentDialog>
