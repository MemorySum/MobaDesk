<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MobaDesk.Views.RemoteEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:MobaDesk.Ui">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="14,8" ColumnSpacing="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE70F;" FontSize="13" Foreground="{StaticResource BrandBlueBrush}" />
                <TextBlock x:Name="FileNameText" FontSize="13" FontWeight="SemiBold" />
                <Border x:Name="LanguageBadge" Padding="6,1" CornerRadius="4" VerticalAlignment="Center"
                        Background="{ThemeResource LayerFillColorAltBrush}">
                    <TextBlock x:Name="LanguageText" FontSize="10"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <TextBlock x:Name="PathText" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="ReloadButton" Style="{StaticResource ToolbarButtonStyle}" Click="OnReloadClick"
                        loc:Loc.ToolTip="Common.Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                </Button>
                <Button x:Name="SaveButton" Style="{StaticResource AccentButtonStyle}" Padding="10,4" Height="30"
                        Click="OnSaveClick" loc:Loc.ToolTip="Common.Save" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE74E;" FontSize="12" />
                        <TextBlock loc:Loc.Key="Common.Save" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="StatusInfoBar" Grid.Row="1" Margin="8,2" Severity="Error" IsOpen="False"
                 IsClosable="True" />

        <WebView2 x:Name="EditorWeb" Grid.Row="2" DefaultBackgroundColor="#0B0F16" />

        <Border Grid.Row="3" Padding="12,3" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon x:Name="ReadOnlyIcon" Glyph="&#xE72E;" FontSize="12" Visibility="Collapsed"
                              Foreground="{StaticResource WarningBrush}"
                              loc:Loc.ToolTip="Editor.ReadOnlyHint" />
                    <TextBlock x:Name="ReadOnlyText" loc:Loc.Key="Editor.ReadOnly" FontSize="11"
                               Visibility="Collapsed" Foreground="{StaticResource WarningBrush}"
                               loc:Loc.ToolTip="Editor.ReadOnlyHint" />
                    <TextBlock x:Name="FileInfoText" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
