<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MobaDesk.Views.RdpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:MobaDesk.Ui">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="780" Padding="24" Spacing="16" HorizontalAlignment="Center">
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="12" Background="#34D399">
                            <FontIcon Glyph="&#xE7F4;" FontSize="22" Foreground="#052E1B" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock loc:Loc.Key="Rdp.Title" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="SubtitleText" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="mstsc" FontSize="10"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </Grid>

                    <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" Severity="Success" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HostBox" loc:Loc.Header="Common.Host" />
                        <NumberBox x:Name="PortBox" Grid.Column="1" loc:Loc.Header="Common.Port" Minimum="1"
                                   Maximum="65535" SpinButtonPlacementMode="Hidden" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="UserBox" loc:Loc.Header="Common.Username" />
                        <TextBox x:Name="DomainBox" Grid.Column="1" loc:Loc.Header="Common.Domain" />
                    </Grid>

                    <PasswordBox x:Name="PasswordInput" loc:Loc.Header="Common.Password"
                                 loc:Loc.Placeholder="Rdp.PasswordPlaceholder" />
                    <CheckBox x:Name="SavePasswordCheck" loc:Loc.Key="Rdp.Remember" IsChecked="True" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="WidthBox" loc:Loc.Header="Rdp.Width" Minimum="640"
                                   Maximum="7680" SpinButtonPlacementMode="Hidden" />
                        <NumberBox x:Name="HeightBox" Grid.Column="1" loc:Loc.Header="Rdp.Height"
                                   Minimum="480" Maximum="4320" SpinButtonPlacementMode="Hidden" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <CheckBox x:Name="FullScreenCheck" loc:Loc.Key="Rdp.FullScreen" />
                        <CheckBox x:Name="DrivesCheck" loc:Loc.Key="Rdp.Drives" />
                        <CheckBox x:Name="ClipboardCheck" loc:Loc.Key="Rdp.Clipboard" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="ConnectButton" loc:Loc.Key="Rdp.Connect"
                                Style="{StaticResource AccentButtonStyle}" Padding="18,8" Click="OnConnectClick" />
                        <Button loc:Loc.Key="Rdp.Save" Padding="14,8" Click="OnSaveClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock loc:Loc.Key="Rdp.NotesTitle" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock loc:Loc.Key="Rdp.Notes1" TextWrapping="Wrap" FontSize="12" LineHeight="20"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock loc:Loc.Key="Rdp.Notes2" TextWrapping="Wrap" FontSize="12" LineHeight="20"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
