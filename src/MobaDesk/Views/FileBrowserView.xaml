<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MobaDesk.Views.FileBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MobaDesk.Models"
    xmlns:loc="using:MobaDesk.Ui">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderPanel" Padding="14,8" ColumnSpacing="8"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource WarningBrush}" />
                <TextBlock x:Name="TitleText" loc:Loc.Key="File.Title" FontSize="13" FontWeight="SemiBold" />
                <TextBlock x:Name="EndpointText" FontSize="11" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                <TextBlock x:Name="ItemCountText" FontSize="11" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                <Button x:Name="ReconnectButton" Style="{StaticResource ToolbarButtonStyle}" Click="OnReconnectClick"
                        loc:Loc.ToolTip="Common.Reconnect">
                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="8,6" ColumnSpacing="6"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnUpClick"
                        loc:Loc.ToolTip="Common.Up">
                    <FontIcon Glyph="&#xE74A;" FontSize="13" />
                </Button>
            </StackPanel>

            <Grid Grid.Column="1" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" FontSize="12" Height="30" CornerRadius="6"
                         KeyDown="OnPathKeyDown" />
                <Button Grid.Column="1" Style="{StaticResource ToolbarButtonStyle}" Click="OnRefreshClick"
                        loc:Loc.ToolTip="Common.Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource ToolbarButtonStyle}" Click="OnNewFolderClick"
                        loc:Loc.ToolTip="Common.NewFolder">
                    <FontIcon Glyph="&#xE8F4;" FontSize="13" />
                </Button>
                <ProgressRing x:Name="BusyRing" Grid.Column="3" Width="16" Height="16" IsActive="False"
                              Visibility="Collapsed" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnUploadClick"
                        loc:Loc.ToolTip="Common.Upload">
                    <FontIcon Glyph="&#xE898;" FontSize="13" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnDownloadClick"
                        loc:Loc.ToolTip="Common.Download">
                    <FontIcon Glyph="&#xE896;" FontSize="13" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnRenameClick"
                        loc:Loc.ToolTip="Common.Rename">
                    <FontIcon Glyph="&#xE8AC;" FontSize="13" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnDeleteClick"
                        loc:Loc.ToolTip="Common.Delete">
                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="StatusInfoBar" Grid.Row="2" Margin="8,2" Severity="Error" IsOpen="False"
                 IsClosable="True" />

        <StackPanel x:Name="ProgressPanel" Grid.Row="3" Padding="12,2,12,4" Spacing="3" Visibility="Collapsed">
            <TextBlock x:Name="ProgressText" FontSize="11" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ProgressBar x:Name="TransferProgress" Maximum="100" Height="4" />
        </StackPanel>

        <Grid Grid.Row="4" Padding="14,3" ColumnSpacing="8"
              Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="108" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" loc:Loc.Key="File.Name" FontSize="10"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="2" loc:Loc.Key="File.Permissions" FontSize="10"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="3" loc:Loc.Key="File.Size" FontSize="10"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="4" loc:Loc.Key="File.Modified" FontSize="10"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <ListView x:Name="EntriesList" Grid.Row="5" SelectionMode="Extended"
                  RightTapped="OnEntriesRightTapped" PreviewKeyDown="OnEntriesKeyDown"
                  DoubleTapped="OnEntriesDoubleTapped" Margin="0,0,0,4">
            <ListView.ContextFlyout>
                <MenuFlyout Opening="OnEntriesContextOpening">
                    <MenuFlyoutItem x:Name="OpenEntryItem" loc:Loc.Key="File.Open" Click="OnOpenEntryContextClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8E5;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="EditEntryItem" loc:Loc.Key="File.Edit" Click="OnEditContextClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE70F;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="DownloadEntryItem" loc:Loc.Key="File.Download"
                                    Click="OnDownloadContextClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE896;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="UploadHereItem" loc:Loc.Key="File.UploadHere"
                                    Click="OnUploadHereContextClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE898;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="NewFolderHereItem" loc:Loc.Key="File.NewFolderHere"
                                    Click="OnNewFolderHereContextClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8F4;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator x:Name="FolderActionsSeparator" />
                    <MenuFlyoutItem x:Name="RenameEntryItem" loc:Loc.Key="Common.Rename"
                                    Click="OnRenameContextClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8AC;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="CopyPathItem" loc:Loc.Key="File.CopyPath"
                                    Click="OnCopyPathContextClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8C8;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="RefreshEntryItem" loc:Loc.Key="Common.Refresh"
                                    Click="OnRefreshContextClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE72C;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator x:Name="DeleteSeparator" />
                    <MenuFlyoutItem x:Name="DeleteEntryItem" loc:Loc.Key="Common.Delete"
                                    Click="OnDeleteContextClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE74D;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </ListView.ContextFlyout>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="34" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:RemoteEntry">
                    <Grid Padding="14,4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="108" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="15" VerticalAlignment="Center"
                                  Foreground="{x:Bind IconBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="12"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{x:Bind PermissionsText}" FontSize="11"
                                   VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas, monospace"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="{x:Bind ModifiedText}" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
