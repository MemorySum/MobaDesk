<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MobaDesk.Views.ConcurrentPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:MobaDesk.Ui">

    <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            CornerRadius="8" Background="#0B0F16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Padding="10,3,4,3" ColumnSpacing="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Width="7" Height="7" Fill="{StaticResource BrandBlueBrush}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock x:Name="EndpointText" FontSize="11" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource ToolbarButtonStyle}" Width="26" Height="26"
                        Padding="0" Click="OnCloseClick" loc:Loc.ToolTip="Common.Close">
                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                </Button>
            </Grid>

            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1"
                    Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <Grid x:Name="TerminalHost" Grid.Row="1" />
        </Grid>
    </Border>
</UserControl>
