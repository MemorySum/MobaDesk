<?xml version="1.0" encoding="utf-8"?>
<!--
  ClickOnce publish profile (Visual Studio: right-click project -> Publish -> ClickOnceProfile).

  Notes:
  - MobaDesk is an unpackaged WinUI 3 app, so it is published self-contained (both .NET and the
    Windows App SDK). Target machines do not need the .NET Desktop Runtime or Windows App Runtime.
  - ClickOnce does not support PublishSingleFile/PublishReadyToRun/PublishTrimmed for this app.
  - The slim-payload pruning is disabled here: ClickOnce builds its file manifest during publish,
    so files must not be deleted after the manifest is generated.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\publish\clickonce\</PublishDir>
    <PublishUrl>$(MSBuildProjectDirectory)\..\..\publish\clickonce\</PublishUrl>
    <InstallUrl>$(MSBuildProjectDirectory)\..\..\publish\clickonce\</InstallUrl>
    <InstallFrom>Disk</InstallFrom>
    <ApplicationVersion>1.0.1.0</ApplicationVersion>
    <ApplicationRevision>0</ApplicationRevision>
    <UseApplicationTrust>false</UseApplicationTrust>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>
    <CreateWebPageOnPublish>false</CreateWebPageOnPublish>
    <MapFileExtensions>false</MapFileExtensions>
    <UpdateEnabled>false</UpdateEnabled>
    <SignManifests>false</SignManifests>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <MobaDeskSlimPayload>false</MobaDeskSlimPayload>
  </PropertyGroup>
</Project>
