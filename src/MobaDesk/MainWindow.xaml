<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MobaDesk.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MobaDesk.Models"
    xmlns:views="using:MobaDesk.Views"
    xmlns:controls="using:MobaDesk.Controls"
    xmlns:loc="using:MobaDesk.Ui"
    Title="MobaDesk">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="14,0,150,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="26" Height="26" CornerRadius="8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#38BDF8" Offset="0" />
                            <GradientStop Color="#2563EB" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="M" Foreground="White" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="MobaDesk" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1"
                        VerticalAlignment="Center">
                    <TextBlock loc:Loc.Key="App.Unlimited" FontSize="10"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>

            <Button x:Name="ToggleSidebarButton" Grid.Column="1" Style="{StaticResource ToolbarButtonStyle}"
                    Margin="14,0,0,0" VerticalAlignment="Center" Click="OnToggleSidebarClick"
                    loc:Loc.ToolTip="App.ToggleSidebar">
                <FontIcon Glyph="&#xE700;" FontSize="13" />
            </Button>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <ToggleButton x:Name="BroadcastToggle" Style="{StaticResource ToolbarToggleButtonStyle}"
                              Click="OnBroadcastToggleClick" loc:Loc.ToolTip="Broadcast.ToolTip">
                    <FontIcon Glyph="&#xE762;" FontSize="14" />
                </ToggleButton>
                <Button x:Name="SettingsButton" Style="{StaticResource ToolbarButtonStyle}" Click="OnSettingsClick"
                        loc:Loc.ToolTip="App.Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
                <Button x:Name="AboutButton" Style="{StaticResource ToolbarButtonStyle}" Click="OnAboutClick"
                        loc:Loc.ToolTip="App.About">
                    <FontIcon Glyph="&#xE946;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="296" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="SidebarRoot" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                  AllowDrop="True" DragOver="OnRootDragOver" Drop="OnRootDrop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Padding="16,14,12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock loc:Loc.Key="Sidebar.Sessions" FontSize="15" FontWeight="SemiBold" />
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8"
                                Padding="6,1" VerticalAlignment="Center">
                            <TextBlock x:Name="ProfileCountText" Text="0" FontSize="10"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <Button x:Name="AddSessionButton" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}"
                            Padding="10,4" Height="30" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                            <TextBlock loc:Loc.Key="Sidebar.New" FontSize="12" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem loc:Loc.Key="Protocol.SSH" Click="OnAddSsh">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE756;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem loc:Loc.Key="Protocol.SFTP" Click="OnAddSftp">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem loc:Loc.Key="Protocol.FTP" Click="OnAddFtp">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE896;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem loc:Loc.Key="Protocol.RDP" Click="OnAddRdp">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7F4;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="NewFolderMenuItem" loc:Loc.Key="Sidebar.NewFolder"
                                                Click="OnNewFolderClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8F4;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <TextBox x:Name="SearchBox" Grid.Row="1" Margin="16,4,16,10"
                         loc:Loc.Placeholder="Sidebar.SearchPlaceholder"
                         TextChanged="OnSearchChanged" FontSize="12" Height="32" CornerRadius="6" />

                <ListView x:Name="SessionsList" Grid.Row="2" Margin="8,0,8,8" SelectionMode="Extended"
                          SelectionChanged="OnSessionsSelectionChanged"
                          CanDragItems="True" AllowDrop="True"
                          DragItemsStarting="OnSessionsDragItemsStarting" DragItemsCompleted="OnSessionsDragItemsCompleted"
                          DragOver="OnSessionsDragOver" Drop="OnSessionsDrop"
                          DoubleTapped="OnSessionsDoubleTapped" RightTapped="OnSessionsRightTapped"
                          KeyDown="OnSessionsKeyDown">
                    <ListView.ContextFlyout>
                        <MenuFlyout Opening="OnSessionsContextOpening">
                            <MenuFlyoutItem x:Name="OpenItem" loc:Loc.Key="Sidebar.Open" Click="OnOpenContextClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8E5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="EditItem" loc:Loc.Key="Sidebar.Edit" Click="OnEditContextClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="DuplicateItem" loc:Loc.Key="Sidebar.Duplicate"
                                            Click="OnDuplicateContextClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem x:Name="MoveToItem" loc:Loc.Key="Sidebar.MoveTo">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xE8F4;" />
                                </MenuFlyoutSubItem.Icon>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator x:Name="ProfileSeparator" />
                            <MenuFlyoutItem x:Name="DeleteItem" loc:Loc.Key="Common.Delete" Click="OnDeleteContextClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="RenameFolderItem" loc:Loc.Key="Sidebar.RenameFolder"
                                            Click="OnRenameFolderClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="DeleteFolderItem" loc:Loc.Key="Sidebar.DeleteFolder"
                                            Click="OnDeleteFolderClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="views:SidebarRow">
                            <Grid>
                                <!-- Folder header -->
                                <Grid Padding="6,5" ColumnSpacing="6" Visibility="{x:Bind FolderVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Style="{StaticResource ToolbarButtonStyle}" Width="24" Height="24"
                                            Padding="0" Background="Transparent" Tag="{x:Bind Folder}"
                                            Click="OnFolderToggleClick">
                                        <FontIcon Glyph="{x:Bind ChevronGlyph}" FontSize="9" />
                                    </Button>

                                    <FontIcon Grid.Column="1" Glyph="&#xE8F4;" FontSize="15" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <TextBlock Grid.Column="2" Text="{x:Bind Folder}" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                    <Border Grid.Column="3" VerticalAlignment="Center" CornerRadius="4" Padding="5,1"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            Visibility="{x:Bind CountVisibility}">
                                        <TextBlock Text="{x:Bind CountText}" FontSize="9"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </Grid>

                                <!-- Session -->
                                <Grid Padding="10,7" ColumnSpacing="10" Margin="{x:Bind RowMargin}"
                                      Visibility="{x:Bind ProfileVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="32" Height="32" CornerRadius="8"
                                            Background="{x:Bind Profile.ColorBrush, Mode=OneWay}">
                                        <FontIcon Glyph="{x:Bind Profile.ProtocolGlyph, Mode=OneWay}" FontSize="14"
                                                  Foreground="White" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{x:Bind Profile.Name, Mode=OneWay}" FontSize="13"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Profile.Subtitle, Mode=OneWay}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="4" Padding="5,1"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind Profile.ProtocolLabel, Mode=OneWay}" FontSize="9"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="3" Padding="16,8,16,12" Spacing="2">
                    <TextBlock loc:Loc.Key="Sidebar.HintDoubleClick" FontSize="10"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock loc:Loc.Key="Sidebar.HintMultiSelect" FontSize="10"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock loc:Loc.Key="Sidebar.HintDrag" FontSize="10"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock loc:Loc.Key="Sidebar.HintUnlimited" FontSize="10"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TabView x:Name="SessionTabs" Grid.Row="0" IsAddTabButtonVisible="False" TabWidthMode="SizeToContent"
                         CloseButtonOverlayMode="OnPointerOver" TabCloseRequested="OnTabCloseRequested"
                         SelectionChanged="OnSessionTabsSelectionChanged"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                         Background="Transparent" Visibility="Collapsed" />

                <Grid x:Name="EmptyState" Grid.Row="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16"
                                    MaxWidth="620" Padding="40,24">
                            <Border Width="74" Height="74" CornerRadius="22" HorizontalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#38BDF8" Offset="0" />
                                        <GradientStop Color="#2563EB" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <FontIcon Glyph="&#xE756;" FontSize="32" Foreground="White" />
                            </Border>

                            <TextBlock loc:Loc.Key="Empty.Title" FontSize="26" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock loc:Loc.Key="Empty.Subtitle"
                                       FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                                        Margin="0,8,0,0">
                                <Button Style="{StaticResource AccentButtonStyle}" Click="OnAddSsh" Padding="16,7">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE756;" FontSize="13" />
                                        <TextBlock loc:Loc.Key="Empty.NewSsh" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnAddSftp" Padding="14,7">
                                    <TextBlock Text="SFTP" />
                                </Button>
                                <Button Click="OnAddFtp" Padding="14,7">
                                    <TextBlock Text="FTP" />
                                </Button>
                                <Button Click="OnAddRdp" Padding="14,7">
                                    <TextBlock Text="RDP" />
                                </Button>
                            </StackPanel>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,8,0,0">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{StaticResource BrandBlueBrush}" />
                                        <TextBlock loc:Loc.Key="Empty.Why" FontWeight="SemiBold" FontSize="13" />
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="20"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               loc:Loc.Key="Empty.Features" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <controls:HorizontalResizeHandle x:Name="BroadcastSplitter" Grid.Row="1"
                                                 Visibility="Collapsed" />

                <Border x:Name="BroadcastBar" Grid.Row="2" Visibility="Collapsed" Padding="12,8"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE762;" FontSize="14" VerticalAlignment="Top" Margin="0,8,0,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                        <TextBox x:Name="BroadcastCommandBox" Grid.Column="1" MinHeight="56"
                                 CornerRadius="6" FontSize="12" FontFamily="Cascadia Mono, Consolas, monospace"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 loc:Loc.Placeholder="Broadcast.Placeholder" />

                        <TextBlock x:Name="BroadcastCountText" Grid.Column="2" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Button x:Name="BroadcastClearButton" Grid.Column="3" Style="{StaticResource ToolbarButtonStyle}"
                                VerticalAlignment="Center" Click="OnBroadcastClearClick"
                                loc:Loc.ToolTip="Broadcast.Clear">
                            <FontIcon Glyph="&#xEA99;" FontSize="14" />
                        </Button>

                        <Button x:Name="BroadcastClearTerminalsButton" Grid.Column="4"
                                Style="{StaticResource ToolbarButtonStyle}"
                                VerticalAlignment="Center" Click="OnBroadcastClearTerminalsClick"
                                loc:Loc.ToolTip="Broadcast.ClearTerminalsToolTip">
                            <FontIcon Glyph="&#xE75C;" FontSize="13" />
                        </Button>

                        <Button x:Name="BroadcastCtrlCButton" Grid.Column="5" Style="{StaticResource ToolbarButtonStyle}"
                                VerticalAlignment="Center" Click="OnBroadcastCtrlCClick"
                                loc:Loc.ToolTip="Broadcast.CtrlCToolTip">
                            <TextBlock Text="⌃C" FontSize="11" FontFamily="Cascadia Mono, Consolas, monospace" />
                        </Button>

                        <Button x:Name="BroadcastSendButton" Grid.Column="6" Style="{StaticResource AccentButtonStyle}"
                                VerticalAlignment="Center" Padding="14,5" Click="OnBroadcastSendClick"
                                loc:Loc.Key="Broadcast.Send" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid Padding="14,0">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource SuccessBrush}" />
                    <TextBlock x:Name="StatusText" loc:Loc.Key="Status.Ready" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="SessionCountText" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="VersionLabel" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
